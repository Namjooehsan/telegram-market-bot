# Never send local credentials or runtime state into Docker build context.
.env
.env.*
!.env.example
**/.env
**/.env.*
**/*.pem
**/*.key
**/id_rsa
**/id_ed25519
**/*credentials*.json
**/*service-account*.json

# Git metadata and local tooling.
.git
.github
.venv
venv
__pycache__
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov

# Local databases, backups, logs, and generated artifacts.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.log
*.bak
*.tmp

# Editor and operating-system files.
.DS_Store
.idea
.vscode
